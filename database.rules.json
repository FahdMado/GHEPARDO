{
  "rules": {
    "orders": {
      ".read": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
      "$orderId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42')",
        ".validate": "newData.hasChildren(['customerName','contact','paymentReference','items','totalEGP','status','timestampMs'])",
        "customerName": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 100"
        },
        "contact": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 120"
        },
        "paymentReference": {
          ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 120"
        },
        "items": {
          ".validate": "newData.hasChildren()",
          "$itemId": {
            ".validate": "newData.hasChildren(['title','price'])",
            "title": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 160"
            },
            "price": {
              ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
            },
            "$other": {
              ".validate": false
            },
            "productId": {
              ".validate": "newData.isString() && newData.val().length <= 128"
            }
          }
        },
        "totalEGP": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500000"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || (auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42' && newData.val() === 'confirmed')"
        },
        "timestampMs": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": "$other === 'downloadToken' && newData.isString() && newData.val().matches(/^[a-f0-9]{48}$/)"
        }
      }
    },
    "subscribers": {
      ".read": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
      "$subscriberId": {
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42')",
        ".validate": "newData.hasChildren(['email','timestampMs'])",
        "email": {
          ".validate": "newData.isString() && newData.val().length >= 5 && newData.val().length <= 254 && newData.val().matches(/^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+[.][A-Za-z]{2,}$/)"
        },
        "timestampMs": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "products": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
      "$productId": {
        ".validate": "newData.hasChildren(['title','description','price','category','status','stock','updatedAt'])",
        "title": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 120"
        },
        "description": {
          ".validate": "newData.isString() && newData.val().length >= 2 && newData.val().length <= 1200"
        },
        "price": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 100000"
        },
        "category": {
          ".validate": "newData.val() === 'dashboard' || newData.val() === 'notion' || newData.val() === 'tools' || newData.val() === 'digital' || newData.val() === 'money' || newData.val() === 'ai' || newData.val() === 'commerce' || newData.val() === 'small-business' || newData.val() === 'travel' || newData.val() === 'mindset' || newData.val() === 'daily'"
        },
        "status": {
          ".validate": "newData.val() === 'draft' || newData.val() === 'published' || newData.val() === 'coming_soon'"
        },
        "stock": {
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 100000"
        },
        "badge": {
          ".validate": "newData.isString() && newData.val().length <= 30"
        },
        "emoji": {
          ".validate": "newData.isString() && newData.val().length <= 12"
        },
        "imageData": {
          ".validate": "newData.isString() && newData.val().length <= 550000"
        },
        "imageUrl": {
          ".validate": "newData.isString() && newData.val().length <= 2048"
        },
        "updatedAt": {
          ".validate": "newData.isNumber() && newData.val() > 0"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "productFiles": {
      ".read": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
      ".write": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'"
    },
    "downloads": {
      "$token": {
        ".read": "!data.exists() || data.child('expiresAt').val() > now",
        ".write": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
        ".validate": "newData.hasChildren(['files','createdAt','expiresAt'])"
      }
    },
    "customerOrders": {
      "$token": {
        ".read": "data.exists()",
        ".write": "(!data.exists() && newData.exists()) || (auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42')",
        ".validate": "newData.hasChildren(['items','totalEGP','status','createdAt','expiresAt','downloadToken'])",
        "items": {
          ".validate": "newData.hasChildren()"
        },
        "totalEGP": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= 500000"
        },
        "status": {
          ".validate": "newData.val() === 'pending' || (auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42' && newData.val() === 'confirmed')"
        },
        "createdAt": {
          ".validate": "newData.isNumber() && newData.val() > 0 && newData.val() <= now + 60000"
        },
        "expiresAt": {
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "downloadToken": {
          ".validate": "newData.isString() && newData.val() === $token"
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "publicStats": {
      ".read": true,
      ".write": "auth != null && auth.uid === 'pDQty2R4KLdv3PBahimLYsG30S42'",
      ".validate": "newData.hasChildren(['trustedUsers','buyers','updatedAt'])",
      "trustedUsers": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "buyers": {
        ".validate": "newData.isNumber() && newData.val() >= 0"
      },
      "updatedAt": {
        ".validate": "newData.isNumber() && newData.val() > 0"
      },
      "$other": {
        ".validate": false
      }
    }
  }
}
